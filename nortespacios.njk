<script>
  (function () {
    var WHATSAPP_NUMBER = '56968023720';
    var DEFAULT_MSG = 'Hola, me interesa la parcela en Las Rojas.';

    function buildWaLink(text) {
      return 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(text);
    }

    document.querySelectorAll('[data-wa-link]').forEach(function (el) {
      el.href = buildWaLink(DEFAULT_MSG);
    });

    var form = document.getElementById('contacto-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nombre = document.getElementById('nombre').value.trim();
        var mensaje = document.getElementById('mensaje').value.trim();
        var parts = [];
        if (nombre) parts.push('Soy ' + nombre + '.');
        parts.push(mensaje || DEFAULT_MSG);
        window.open(buildWaLink(parts.join(' ')), '_blank', 'noopener');
      });
    }
  })();
</script>
