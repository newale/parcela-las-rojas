<!doctype html>
<html class="light" lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Manrope:wght@200..800&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "tertiary-container": "#65645b",
              "on-tertiary": "#ffffff",
              "outline-variant": "#c5c8b8",
              "surface-container": "#efeeeb",
              secondary: "#6e5c37",
              "tertiary-fixed": "#e5e2d8",
              tertiary: "#4d4c44",
              "on-primary-fixed": "#131f00",
              "on-secondary-fixed": "#261a00",
              "surface-container-high": "#e9e8e5",
              "surface-bright": "#faf9f6",
              "primary-container": "#556b2f",
              "primary-fixed": "#d2eca2",
              "surface-tint": "#50652a",
              "on-secondary-container": "#73603b",
              "on-secondary": "#ffffff",
              surface: "#faf9f6",
              "secondary-fixed-dim": "#dcc497",
              "on-primary-fixed-variant": "#394d14",
              "inverse-primary": "#b6d088",
              "on-tertiary-fixed-variant": "#48473f",
              "on-tertiary-fixed": "#1c1c15",
              "on-error-container": "#93000a",
              "on-surface-variant": "#45483c",
              "inverse-on-surface": "#f2f1ee",
              "error-container": "#ffdad6",
              "on-background": "#1a1c1a",
              "tertiary-fixed-dim": "#c9c7bc",
              "secondary-fixed": "#f9dfb1",
              "surface-variant": "#e3e2e0",
              "surface-container-low": "#f4f3f1",
              "surface-container-lowest": "#ffffff",
              "on-secondary-fixed-variant": "#554422",
              "on-error": "#ffffff",
              "primary-fixed-dim": "#b6d088",
              "on-surface": "#1a1c1a",
              "surface-dim": "#dbdad7",
              "secondary-container": "#f6ddae",
              background: "#faf9f6",
              "on-primary": "#ffffff",
              "on-tertiary-container": "#e4e1d6",
              "surface-container-highest": "#e3e2e0",
              primary: "#3e5219",
              "inverse-surface": "#2f312f",
              error: "#ba1a1a",
              outline: "#75796b",
              "on-primary-container": "#d0eba1",
            },
            fontFamily: {
              headline: ["Newsreader", "serif"],
              body: ["Manrope", "sans-serif"],
              label: ["Manrope", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.125rem",
              lg: "0.25rem",
              xl: "0.5rem",
              full: "0.75rem",
            },
          },
        },
      };
    </script>
    <style>
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 300,
          "GRAD" 0,
          "opsz" 24;
      }
      .serif-tight {
        font-family: "Newsreader", serif;
        letter-spacing: -0.02em;
      }
      .glass-card {
        background: rgba(227, 226, 224, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }
    </style>
  </head>
  <body
    class="bg-surface text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed"
  >
    <!-- TopAppBar -->
    <header
      class="fixed top-0 w-full z-50 bg-[#faf9f6]/90 dark:bg-[#1a1c1a]/90 backdrop-blur-md"
    >
      <nav
        class="flex justify-between items-center px-8 py-6 max-w-full mx-auto"
      >
        <div
          class="text-2xl font-serif italic text-[#3e5219] dark:text-[#faf9f6]"
        >
          Parcela en Las Rojas
        </div>
        <div class="hidden md:flex items-center gap-10">
          <a
            class="text-[#3e5219] dark:text-[#faf9f6] font-bold border-b-2 border-[#3e5219] pb-1 transition-colors duration-300 ease-in-out"
            href="#"
            >Propiedad</a
          >
          <a
            class="text-[#45483c] dark:text-[#c5c8b8] hover:text-[#3e5219] transition-colors duration-300 ease-in-out"
            href="galeria/"
            >Galería</a
          >
          <a
            class="text-[#45483c] dark:text-[#c5c8b8] hover:text-[#3e5219] transition-colors duration-300 ease-in-out"
            href="#"
            >Entorno</a
          >
          <a
            class="text-[#45483c] dark:text-[#c5c8b8] hover:text-[#3e5219] transition-colors duration-300 ease-in-out"
            href="#"
            >Contacto</a
          >
        </div>
        <button
          class="bg-primary text-on-primary px-6 py-2.5 rounded-lg font-label text-sm uppercase tracking-wider hover:bg-primary-container transition-all duration-300 active:opacity-80"
        >
          Agendar Visita
        </button>
      </nav>
    </header>
    {{ content | safe }}
    <!-- Footer -->
    <footer
      class="w-full border-t border-[#c5c8b8]/20 bg-[#efeeeb] dark:bg-[#1a1c1a]"
    >
      <div
        class="flex flex-col md:flex-row justify-between items-center px-12 py-10 w-full"
      >
        <div class="text-lg font-serif text-[#3e5219] mb-6 md:mb-0">
          Parcela La Serena
        </div>
        <div class="flex gap-8 mb-6 md:mb-0">
          <a
            class="text-[#45483c] font-sans text-sm tracking-wide uppercase hover:text-[#3e5219] dark:hover:text-[#faf9f6] transition-colors"
            href="#"
            >WhatsApp</a
          >
          <a
            class="text-[#45483c] font-sans text-sm tracking-wide uppercase hover:text-[#3e5219] dark:hover:text-[#faf9f6] transition-colors"
            href="#"
            >Portal Inmobiliario</a
          >
          <a
            class="text-[#45483c] font-sans text-sm tracking-wide uppercase hover:text-[#3e5219] dark:hover:text-[#faf9f6] transition-colors"
            href="#"
            >Mapa de Ubicación</a
          >
        </div>
        <p
          class="text-[#45483c] font-sans text-xs uppercase tracking-widest opacity-60"
        >
          © 2024 Inmobiliaria La Serena. Todos los derechos reservados.
        </p>
      </div>
    </footer>
    <!-- Floating Contact Button -->
    <a
      class="fixed bottom-8 right-8 z-[60] bg-[#25D366] text-white p-4 rounded-full shadow-2xl flex items-center gap-3 group hover:scale-105 transition-all active:scale-95"
      href="https://wa.me/56900000000"
    >
      <span
        class="material-symbols-outlined"
        style="font-variation-settings: &quot;FILL&quot; 1"
        >chat</span
      >
      <span
        class="max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-[150px] transition-all duration-500 font-label font-bold text-sm uppercase"
        >Consultar WhatsApp</span
      >
    </a>
  </body>
</html>